{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meal-tracker-cloud",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/v1/*", "/mcp", "/mcp/*", "/oauth/*", "/.well-known/*"]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "94cf4dfa0f7c406d8e59eb27e8cf470c" }],
  "triggers": { "crons": ["17 18 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-tracker-db",
      "database_id": "0d8841e8-1d3d-415d-a32d-06f4196bd05b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://keiton212.github.io,http://localhost:8787,http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
