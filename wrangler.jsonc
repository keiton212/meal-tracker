{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meal-tracker-cloud",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meal-tracker-db",
      "database_id": "0d8841e8-1d3d-415d-a32d-06f4196bd05b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://keiton212.github.io,http://localhost:8787,http://127.0.0.1:8787"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
