{
  "name": "meal-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --persist-to .wrangler/state",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply meal-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meal-tracker-db --remote",
    "check": "node --check worker/index.js && node --check worker/inbox.js && node --check worker/oauth.js && node --check worker/mcp.js && node --check js/cloud-sync.js && node --check js/inbox.js && node --check scripts/build.mjs",
    "test:mcp": "node scripts/test-mcp.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "wrangler": "^4.138.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
