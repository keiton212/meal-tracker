{
  "name": "meal-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev --persist-to .wrangler/state",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply meal-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply meal-tracker-db --remote",
    "check": "node --check worker/index.js && node --check js/cloud-sync.js && node --check scripts/build.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
